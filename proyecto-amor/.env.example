# Copia este archivo a ".env" (sin ".example") y rellena tus propios valores.
# El archivo ".env" NUNCA se sube a GitHub (está en .gitignore).

# --- Contraseña inicial del panel de administración ---
# Solo se usa la primera vez que arranca el servidor, para crear tu cuenta.
# Después la cambias desde /admin -> pestaña Ajustes.
ADMIN_PASSWORD=escribe-aqui-una-clave-que-solo-tu-sepas

# --- Turso (base de datos en la nube) ---
# Si dejas esto vacío, el proyecto usa un archivo local (mensajes.db) para que
# puedas probar en tu compu sin necesidad de cuenta. Para producción (Render)
# SÍ necesitas llenar esto, o los datos se perderán en cada reinicio.
# Sácalos de tu dashboard de turso.tech, dentro de tu base de datos -> "Connect".
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Cloudinary (fotos subidas desde tu compu) ---
# Sácalos de tu dashboard de cloudinary.com (Cloud name, API Key, API Secret).
# Si los dejas vacíos, la opción "subir desde tu compu" no va a funcionar, pero
# sí puedes seguir agregando fotos pegando una URL (ej. de imgur).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Sesión de login (opcional) ---
# Si lo defines, tu sesión de admin sobrevive a los reinicios del servidor.
# Si lo dejas vacío, funciona igual, solo que tendrías que volver a iniciar
# sesión cada vez que Render reinicie el contenedor. Puedes generar uno con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
