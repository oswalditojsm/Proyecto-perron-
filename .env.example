# Copia este archivo a ".env" (sin ".example") y rellena tus propios valores.
# El archivo ".env" NUNCA se sube a GitHub (está en .gitignore).

# --- Contraseña inicial del panel de administración ---
# Solo se usa la primera vez que arranca el servidor, para crear tu cuenta.
# Después la cambias desde /admin -> pestaña Ajustes.
ADMIN_PASSWORD=escribe-aqui-una-clave-que-solo-tu-sepas

# --- Turso (base de datos en la nube) ---
# Si dejas esto vacío, el proyecto usa un archivo local (mensajes.db) para que
# puedas probar en tu compu sin necesidad de cuenta. Para producción (Render)
# SÍ necesitas llenar esto, o los datos se perderán en cada reinicio.
# Sácalos de tu dashboard de turso.tech, dentro de tu base de datos -> "Connect".
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Cloudinary (fotos subidas desde tu compu) ---
# Sácalos de tu dashboard de cloudinary.com (Cloud name, API Key, API Secret).
# Si los dejas vacíos, la opción "subir desde tu compu" no va a funcionar, pero
# sí puedes seguir agregando fotos pegando una URL (ej. de imgur).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Sesión de login (opcional) ---
# Si lo defines, tu sesión de admin sobrevive a los reinicios del servidor.
# Si lo dejas vacío, funciona igual, solo que tendrías que volver a iniciar
# sesión cada vez que Render reinicie el contenedor. Puedes generar uno con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Notificaciones push (avisan aunque la app esté cerrada) ---
# Estas dos ya vienen generadas y listas para usarse (son un par válido).
# Puedes dejarlas así para tu proyecto personal. Si algún día quieres generar
# un par nuevo tú mismo, corre:
# node -e "const c=require('crypto');const{publicKey,privateKey}=c.generateKeyPairSync('ec',{namedCurve:'prime256v1'});const p=publicKey.export({format:'jwk'});const s=privateKey.export({format:'jwk'});const b=(x)=>Buffer.from(x,'base64url');console.log('VAPID_PUBLIC_KEY='+Buffer.concat([Buffer.from([4]),b(p.x),b(p.y)]).toString('base64url'));console.log('VAPID_PRIVATE_KEY='+s.d);"
# Si dejas estas dos vacías, el sitio funciona igual, solo sin notificaciones push.
VAPID_PUBLIC_KEY=BH9aaAtLA9L_RTbyqjCwxhGXYkwGsK3CfBy3dPjLxj6gl8-Xt-0TAi-hYpvpFE6dvBm6bbnQvTOMDBxNpm2eKhw
VAPID_PRIVATE_KEY=eKRYZptKUwJ0PNqDf4PF2pAV3vxAPVIsi-caO1dw2hU
# Un correo o URL de contacto, requerido por el estándar VAPID (no se muestra
# a nadie, es solo para que los navegadores sepan a quién avisar si hay abuso).
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
